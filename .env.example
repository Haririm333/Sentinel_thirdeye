# SENTINEL Environment Configuration Template
# Copy this file to .env and adjust variables for your local setup.

# Environment Mode: development | testing | production
ENVIRONMENT=development

# Server Binding (Restricted to localhost during development for security)
HOST=127.0.0.1
PORT=8000

# PostgreSQL Database Connection
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://sentinel_user:sentinel_secure_pass@localhost:5432/sentinel_db

# Optional SQLite fallback for offline local testing / development without running PostgreSQL
# DATABASE_URL=sqlite:///./sentinel_local.db

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Security & Limits
MAX_REQUEST_SIZE_BYTES=1048576
LOG_LEVEL=INFO
ALLOWED_SOURCE_SYSTEMS=["LedgerOne","HelpDeskr","TallyBridge"]
